{
  "name": "cadence",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "onlyBuiltDependencies": ["bcrypt", "better-sqlite3", "esbuild"]
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @cadence/frontend dev",
    "dev:server": "pnpm --filter @cadence/server dev",
    "build": "pnpm --filter @cadence/shared build && pnpm --filter @cadence/frontend build && pnpm --filter @cadence/server build",
    "start": "pnpm --filter @cadence/server start"
  }
}
